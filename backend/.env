# ════════════════════════════════════════════════════════════
#  SkillPath AI — Environment Configuration
#  Fill in the values below, then restart the backend server.
# ════════════════════════════════════════════════════════════

# ── REQUIRED: Database ──────────────────────────────────────
# Local MongoDB (default):
MONGO_URL=mongodb://localhost:27017
# MongoDB Atlas (production — replace with your connection string):
# MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=skillpath_ai

# ── REQUIRED: Auth Secret ───────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_ME_generate_with_command_above
JWT_EXPIRE_MINUTES=10080

# ── REQUIRED: Anthropic AI ──────────────────────────────────
# Step 1: Go to https://console.anthropic.com/api-keys
# Step 2: Click "Create Key"
# Step 3: Copy the key (starts with sk-ant-api03-...)
# Step 4: Paste it below:
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── OPTIONAL: GitHub (increases rate limit from 60 to 5000 req/hr) ──
# Get from: https://github.com/settings/tokens → Generate new token → select public_repo
GITHUB_TOKEN=

# ── OPTIONAL: Google OAuth ──────────────────────────────────
# Get from: https://console.cloud.google.com → OAuth 2.0 credentials
GOOGLE_CLIENT_ID=

# ── OPTIONAL: File Storage (for resume uploads in production) ──
# Without this, resumes are stored in /tmp and lost on server restart.
# Free tier at cloudinary.com → Dashboard → copy the CLOUDINARY_URL
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=

# ── OPTIONAL: Email (for forgot-password emails) ─────────────
# Free 100 emails/day at sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=

# ── CORS (update after Vercel deployment) ───────────────────
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Claude Model ────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-20250514
